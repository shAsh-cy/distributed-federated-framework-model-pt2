{
  "name": "fl-dashboard",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Instrument-style dashboard for the federated learning coordinator",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "e2e": "playwright test",
    "gen:api": "openapi-typescript ../docs/openapi.json -o src/lib/api.gen.ts",
    "e2e:serve": "vite build && vite preview --host 127.0.0.1 --port 4173 --strictPort",
    "record:story": "playwright test --config playwright.record.config.ts"
  },
  "dependencies": {
    "@tanstack/react-query": "5.59.16",
    "framer-motion": "11.11.9",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "recharts": "2.13.3"
  },
  "devDependencies": {
    "@playwright/test": "1.48.2",
    "@testing-library/jest-dom": "6.6.3",
    "@testing-library/react": "16.0.1",
    "@testing-library/user-event": "14.5.2",
    "@types/node": "^22.8.7",
    "@types/react": "18.3.12",
    "@types/react-dom": "18.3.1",
    "@vitejs/plugin-react": "4.3.3",
    "autoprefixer": "10.4.20",
    "jsdom": "25.0.1",
    "msw": "2.6.4",
    "openapi-typescript": "7.4.3",
    "postcss": "8.4.49",
    "tailwindcss": "3.4.14",
    "typescript": "5.6.3",
    "vite": "5.4.10",
    "vitest": "2.1.4"
  }
}
